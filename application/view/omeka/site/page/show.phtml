<?php
$this->headLink()->appendStylesheet($this->assetUrl('css/page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', $pageBodyClass);
$this->pageTitle($page->title(), 2);
$nav = $site->publicNav();
$activePage = $nav->findActive($nav->getContainer());
switch ($this->siteSetting('subnav_display')) {
    case 'show';
        $displaySubnav = $this->displayNavigation;
        break;
    case 'hide':
        $displaySubnav = false;
        break;
    default:
        $displaySubnav = $this->displayNavigation && $activePage && $activePage['page']->hasPages();
}

?>

<?php if ($activePage): ?>
<?php if ($activePage['depth'] !== 0): ?>
<nav class="breadcrumbs"><?php echo $nav->breadcrumbs(); ?></nav>
<?php endif; ?>
<?php endif; ?>

<?php if ($activePage): ?>

<?php
$escape = $this->plugin('escapeHtml');

if ($activePage && $activePage['page']->hasPages()):
    $subPages = $activePage['page']->getPages();
?>
<div class="submenu-wrapper">
    <h2 class="submenu-heading"><?= $escape($page->title()) ?></h2> <!-- FIXED: use current page title -->

    <div class="custom-submenu">
        <?php foreach ($subPages as $child): ?>
            <?php if (!$child->isVisible()) continue; ?>

            <?php
                $pageResource = $child->getResource(); // SitePage
                $media = null;
                if ($pageResource && method_exists($pageResource, 'media') && $pageResource->media()) {
                    $media = $pageResource->media()[0];
                }
            ?>

            <div class="submenu-card">
                <a href="<?= $escape($child->getHref()) ?>">
                    <?php if ($media): ?>
                        <img src="<?= $media->thumbnailUrl('square') ?>" alt="<?= $escape($child->getLabel()) ?>" />
                    <?php endif; ?>
                    <div class="submenu-title"><?= $escape($child->getLabel()) ?></div>
                </a>
            </div>
        <?php endforeach; ?>
    </div>
</div>
<?php endif; ?>

<?php endif; ?>

